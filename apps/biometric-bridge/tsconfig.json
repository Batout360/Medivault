{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noUncheckedIndexedAccess": false,
    "baseUrl": "./",
    "paths": {
      "@medivault/mfs100-sdk": ["../../packages/mfs100-sdk/src/index.ts"],
      "@medivault/mfs100-sdk/*": ["../../packages/mfs100-sdk/src/*"],
      "@medivault/mso-sdk": ["../../packages/mso-sdk/src/index.ts"],
      "@medivault/mso-sdk/*": ["../../packages/mso-sdk/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}