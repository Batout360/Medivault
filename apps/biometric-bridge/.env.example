# ─────────────────────────────────────────────────────────────────────────────
# Medivault Biometric Bridge — Environment Variables
# Copy this file to .env and fill in all values. NEVER commit .env.
# The bridge runs LOCALLY on the workstation with the MFS100 scanner attached
# and is never exposed publicly (binds to 127.0.0.1 by default).
# ─────────────────────────────────────────────────────────────────────────────

# Adapter selection: "auto" (prefer mfs100, then generic-usb), "mfs100", or
# "generic-usb".
BIOMETRIC_ADAPTER=auto

# Optional: when enabled, every bridge request/WebSocket hello must carry this
# bearer token (Authorization: Bearer <token>). The web client sends it via
# NEXT_PUBLIC_BIOMETRIC_BRIDGE_TOKEN.
BIOMETRIC_BRIDGE_TOKEN=

# Optional: serial numbers (comma-separated) of scanners this bridge may use.
# Leave empty to accept any detected device.
BIOMETRIC_ALLOWED_DEVICES=

# AES-256 key (>= 32 chars) used to encrypt captured minutiae templates before
# they leave this machine. MUST match the backend BIOMETRIC_ENCRYPTION_KEY.
BIOMETRIC_ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_RANDOM_STRING

# HMAC secret used to sign encrypted payloads (anti-tamper). MUST match the
# backend BIOMETRIC_BRIDGE_SECRET.
BIOMETRIC_BRIDGE_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING

# Optional: vendor/product overrides for auto-detection (hex). Defaults:
# MFS100 vendor 0x04b4, products 0x8613 and 0x1005.
# MFS100_VENDOR_ID=0x04b4
# MFS100_PRODUCT_ID=0x8613,0x1005

# Bridge port (default 9876) and host (keep 127.0.0.1 in production).
BIOMETRIC_BRIDGE_PORT=9876
BIOMETRIC_BRIDGE_HOST=127.0.0.1

# Log level: debug | info | warn | error. "debug" logs raw device events.
LOG_LEVEL=info