# ─────────────────────────────────────────────────────────────────────────────
# Medivault Biometric Bridge — Environment Variables
# Copy this file to .env and fill in all values. NEVER commit .env.
# The bridge runs LOCALLY on the workstation with the MSO 1300 scanner attached
# and is never exposed publicly (binds to 127.0.0.1 by default).
# ─────────────────────────────────────────────────────────────────────────────

# Adapter selection: mso1300 (default), mfs100, generic-usb, or auto.
# "auto" probes the USB bus; detection priority is mso1300 > mfs100 > generic-usb.
BIOMETRIC_ADAPTER=mso1300

# Optional: when enabled, every bridge request/WebSocket hello must carry this
# bearer token (Authorization: Bearer <token>). The web client sends it via
# NEXT_PUBLIC_BIOMETRIC_BRIDGE_TOKEN.
BIOMETRIC_BRIDGE_TOKEN=

# Optional: serial numbers (comma-separated) of scanners this bridge may use.
# Leave empty to accept any detected device.
BIOMETRIC_ALLOWED_DEVICES=

# AES-256 key (>= 32 chars) used to encrypt captured minutiae templates before
# they leave this machine. MUST match the backend BIOMETRIC_ENCRYPTION_KEY.
BIOMETRIC_ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_RANDOM_STRING

# HMAC secret used to sign encrypted payloads (anti-tamper). MUST match the
# backend BIOMETRIC_BRIDGE_SECRET.
BIOMETRIC_BRIDGE_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING

# ─── Idemia MSO 1300 E3 SDK ───────────────────────────────────────────────────
# Path to MorphoSmartCST.dll from the Idemia MSO SDK, or a directory containing
# it. If unset, the following paths are probed automatically:
#   C:\Program Files\Idemia\MSO SDK\MorphoSmartCST.dll
#   C:\Program Files\Morpho\MorphoSmartCST\MorphoSmartCST.dll
#   C:\MORPHO\MorphoSmartCST.dll
# MSO_SDK_DLL=C:\Program Files\Idemia\MSO SDK\MorphoSmartCST.dll
# MSO_SDK_DIR=C:\Program Files\Idemia\MSO SDK

# License key issued by Idemia for this device serial.
# MSO_LICENSE_KEY=<license-from-idemia>

# Optional USB vendor/product overrides for auto-detection (hex).
# Defaults: Idemia vendor 0x1DCF, products 0x0007 and 0x0004.
# MSO_VENDOR_ID=0x1DCF
# MSO_PRODUCT_ID=0x0007,0x0004

# Raw SDK match score threshold (0–100000). Lower = stricter. Default 14000.
# MSO_MATCH_THRESHOLD=14000

# ─── Bridge network ──────────────────────────────────────────────────────────
# Keep host as 127.0.0.1 in production — never expose on a public interface.
BIOMETRIC_BRIDGE_PORT=9876
BIOMETRIC_BRIDGE_HOST=127.0.0.1

# Log level: debug | info | warn | error
LOG_LEVEL=info
