# Medivault — production/hosted build defaults.
#
# This file IS committed and IS picked up by Next.js when NODE_ENV=production,
# which is what Vercel uses. It exists so a fresh deploy builds successfully
# instead of failing on undefined variables.
#
# Nothing secret belongs here. These are all public NEXT_PUBLIC_* values or
# non-secret flags. Real secrets live only in the platform's env settings.
#
# Anything set in the Vercel dashboard OVERRIDES these values.

# ─── Required: set this in the Vercel dashboard ─────────────────────────────
# Absolute origin of the backend, no trailing slash, NO /api/v1 suffix.
# The rewrite in next.config.js proxies /api/* to <BACKEND_API_URL>/api/*.
# Without it the API is unreachable and every page renders empty.
BACKEND_API_URL=https://REPLACE-WITH-YOUR-BACKEND-URL

# Relative path on purpose: keeps API calls same-origin so the CSP only needs
# 'self', and lets the browser set cookies without cross-origin CORS.
NEXT_PUBLIC_API_URL=/api/v1

# ─── App identity ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Medivault
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_SUPPORT_EMAIL=support@medivault.internal

# ─── Feature flags ──────────────────────────────────────────────────────────
# The MFS100 scanner is USB hardware. It only works when the bridge is running
# on the same machine as the browser, so this is safe to leave on for hosted
# builds — capture simply reports "bridge unreachable" elsewhere.
NEXT_PUBLIC_BIOMETRIC_ENABLED=true
NEXT_PUBLIC_BIOMETRIC_BRIDGE_URL=ws://localhost:9876
NEXT_PUBLIC_TELEMEDICINE_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# ─── Build flags ────────────────────────────────────────────────────────────
# next@14.2.35's optionalDependencies pin @next/swc-* at 14.2.33, which does
# exist for the bindings. Next's lockfile-patcher tries to look up 14.2.35 on the
# per-platform swc packages, throws, and logs "Failed to patch lockfile".
# Skipping the patch is safe — the installed binding is already correct.
NEXT_IGNORE_INCORRECT_LOCKFILE=1
