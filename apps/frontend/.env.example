# ─────────────────────────────────────────────────────────────────────────────
# Medivault Frontend — Environment Variables
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── API URLs ─────────────────────────────────────────────────────────────────
# Server-side (Node runtime): the base origin WITHOUT any path. Used by the
# rewrites in next.config.js (/api/* is proxied to this) and by
# getServerSession() in src/lib/auth/session.ts. Do NOT append /api/v1.
#   Local:   BACKEND_API_URL=http://localhost:3001
#   Vercel:  BACKEND_API_URL=https://your-backend-host.example.com
BACKEND_API_URL=http://localhost:3001

# Client-side (browser): apiClient (src/lib/api/client.ts) uses this exactly as
# its axios baseURL, INCLUDING the /api/v1 prefix.
#   Local dev: absolute URL of the running backend:
#     NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
#   Vercel: use the RELATIVE path so API calls are same-origin and proxied to
#     the backend by rewrites — avoids CORS and cross-site cookie problems:
#     NEXT_PUBLIC_API_URL=/api/v1  (requires BACKEND_API_URL above)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ── App Config ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Medivault
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_SUPPORT_EMAIL=support@medivault.internal

# ── Feature Flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_BIOMETRIC_ENABLED=true
# Local biometric bridge WebSocket URL (the bridge talks to USB scanners).
# Leave unset to default to ws://localhost:9876.
NEXT_PUBLIC_BIOMETRIC_BRIDGE_URL=ws://localhost:9876
# Optional: must match the bridge BIOMETRIC_BRIDGE_TOKEN when bridge auth is on.
# NEXT_PUBLIC_BIOMETRIC_BRIDGE_TOKEN=
NEXT_PUBLIC_TELEMEDICINE_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# ── Vercel deployment ─────────────────────────────────────────────────────────
# In Vercel Project Settings > Environment Variables, define (All environments):
#   NEXT_PUBLIC_API_URL=/api/v1
#   BACKEND_API_URL=https://<deployed-backend-origin>
# plus the NEXT_PUBLIC_* values above. Do NOT store secrets with a NEXT_PUBLIC_
# prefix — they are inlined into the client bundle.