# ─────────────────────────────────────────────────────────────────────────────
# Medivault Backend — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local or .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database (MongoDB) ────────────────────────────────────────────────────────
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/medivault?appName=Cluster0

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT (generate with: openssl rand -base64 64) ────────────────────────────
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Security ─────────────────────────────────────────────────────────────────
COOKIE_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING
BCRYPT_ROUNDS=12
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── File Storage ─────────────────────────────────────────────────────────────
# local = filesystem under STORAGE_LOCAL_PATH
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# gridfs = files inside MongoDB (fs.files/fs.chunks), no filesystem required
# STORAGE_PROVIDER=gridfs
# STORAGE_GRIDFS_BUCKET=uploads
# For S3 storage:
# STORAGE_PROVIDER=s3
# AWS_S3_BUCKET=medivault-documents-dev
# AWS_S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@medivault.internal

# ── Biometric Service ────────────────────────────────────────────────────────
# Matcher provider. Only "mfs100" is implemented (MFS100BiometricProvider is the
# sole BIOMETRIC_PROVIDER binding in biometric.module.ts) and it is the only value
# the Joi schema in app.module.ts accepts — anything else fails validation on boot.
# The provider is inert on non-Windows hosts: the MFS100.dll FFI load is gated
# behind a process.platform === 'win32' check, so cloud deploys boot cleanly with
# biometric capture unavailable.
BIOMETRIC_PROVIDER=mfs100
# Similarity threshold 0–100 used by the backend identity flow.
BIOMETRIC_MATCH_THRESHOLD=85
# AES-256 key for encrypting biometric templates at rest (min 32 chars, random)
BIOMETRIC_ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_RANDOM_STRING
# Shared secret with the local biometric bridge. When set, captures MUST carry
# a valid bridge HMAC and opaque (encrypted) payload or they are rejected.
# Use the same value in apps/biometric-bridge (BIOMETRIC_BRIDGE_SECRET) and in
# the frontend bridge token (NEXT_PUBLIC_BIOMETRIC_BRIDGE_TOKEN) if auth is enabled.
BIOMETRIC_BRIDGE_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING
# Comma-separated device serials allowed to submit captures (empty = any).
BIOMETRIC_ALLOWED_DEVICES=
# MFS100 SDK matcher tuning (raw SDK score 0–100000, default 14000).
MFS100_MATCH_THRESHOLD=14000
# Optional MFS100 license key the backend matcher registers at startup.
MFS100_LICENSE_KEY=

# ── MFA Encryption ────────────────────────────────────────────────────────────
# AES-256 key for encrypting TOTP secrets in the database (min 32 chars, random)
MFA_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_32_CHAR_RANDOM_STRING

# ── Medical Profile QR ─────────────────────────────────────────────────────────
# AES-256 key for encrypting the medical profile QR scan codes at rest.
# Only a SHA-256 hash of the code is used for verification; the encrypted code
# enables re-rendering the QR PNG on demand (min 32 chars, random).
QR_ENCRYPTION_KEY=REPLACE_WITH_ANOTHER_DIFFERENT_32_CHAR_RANDOM_STRING

# Public origin of the frontend used to build the QR payload URL
# (e.g. https://medivault.example.com). The verified QR opens {FRONTEND_URL}/verify/<code>.
FRONTEND_URL=http://localhost:3000

# ── Document Storage Signing ──────────────────────────────────────────────────
# HMAC-SHA256 key for signing download tokens (min 32 chars, random)
STORAGE_SIGNING_SECRET=REPLACE_WITH_ANOTHER_32_CHAR_RANDOM_STRING

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60
# Requests allowed per TTL window. Higher for dev; use tighter limits in prod.
THROTTLE_LIMIT=600
